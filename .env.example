# CIFAR-100 Image Classifier - Environment Configuration Example

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated origins, or * for open access)
# For local development:
ALLOWED_ORIGINS=*
# For production (replace with your Vercel deployment URL):
# ALLOWED_ORIGINS=https://your-cifar100.vercel.app,http://localhost:8080

# Logging & Performance
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
