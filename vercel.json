{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/predict",
      "destination": "https://cifar100-image-classifier-production.up.railway.app/predict"
    },
    {
      "source": "/health",
      "destination": "https://cifar100-image-classifier-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
